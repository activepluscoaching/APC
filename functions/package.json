{
  "name": "active-plus-functions",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "emulate": "firebase emulators:start --only auth,firestore,functions",
    "test:rules": "firebase emulators:exec --only firestore \"node --test test/firestore-rules.test.js\"",
    "deploy": "firebase deploy --only functions,firestore:rules",
    "test:rtdb-rules": "firebase emulators:exec --only database \"node --test test/rtdb-rules.test.js\""
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0"
  }
}
